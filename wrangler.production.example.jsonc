{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "name": "ip-fal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ip.example.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_HOST": "ip.example.com",
    "FAL_MODEL_ID": "fal-ai/flux-2/turbo"
  },
  "ratelimits": [
    {
      "name": "GENERATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  }
}
